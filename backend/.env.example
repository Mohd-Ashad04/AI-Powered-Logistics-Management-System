# Server Configuration
PORT=3000
NODE_ENV=development
SECRET_KEY=your_jwt_secret_key_here

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/logistics_db
TEST_DATABASE_URI=mongodb+srv://username:password@cluster.mongodb.net/logistics_test_db

# External APIs
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# Payment (Optional)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISH_KEY=your_stripe_publish_key_here

# Allowed Origins (CORS) — comma-separated for multiple origins
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:2000
CLIENT_URL=http://localhost:2001
